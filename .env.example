# ==============================================================================
# Hybrid_PDF_Reading_Order - Environment Configuration Template
# ==============================================================================

# Project & Environment
PROJECT_NAME="Hybrid_PDF_Reading_Order"
VERSION="0.1.0"
ENVIRONMENT="development"  # development | staging | production | testing
DEBUG=false

# API Server Settings
API_HOST="127.0.0.1"
API_PORT=8000
API_PREFIX="/api/v1"

# Runtime Execution & Hardware
EXECUTION_MODE="auto"      # auto | cpu | gpu
GPU_DEVICE_ID=0
ALLOW_GPU_FALLBACK=true
CPU_WORKERS=4
THREAD_COUNT=4

# Logging Settings
LOG_LEVEL="INFO"           # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FILE_NAME="app.log"
LOG_TO_CONSOLE=true
LOG_TO_FILE=true

# Processing Bounds & Safety Limits
MAX_PDF_FILE_SIZE_BYTES=52428800  # 50 MB
MAX_PAGE_COUNT=200
PROCESSING_TIMEOUT_SECONDS=300

# Directory Configuration (relative to project root or absolute paths)
OUTPUT_DIR_NAME="output"
LOG_DIR_NAME="output/logs"
REPORT_DIR_NAME="output/reports"
PROCESSED_DIR_NAME="output/processed"
MODELS_DIR_NAME="models"
DATASETS_DIR_NAME="datasets"
TEMP_DIR_NAME="output/temp"

